DEEPGRAM_API_KEY=your_deepgram_api_key
GROQ_API_KEY=your_groq_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# Required for a browser that is not on the same machine as the bot.
# Comma-separated STUN/TURN URLs, or a JSON array. TURN is required for phones and strict NATs.
PIPECAT_ICE_SERVERS=stun:stun.l.google.com:19302,{"urls":"turn:YOUR_TURN_HOST:3478","username":"YOUR_USER","credential":"YOUR_PASSWORD"}

# Comma-separated frontend origins allowed to open a session. Example: https://your-app.pages.dev
PIPECAT_ALLOWED_ORIGINS=https://your-frontend-origin
